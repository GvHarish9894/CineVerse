<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debuggable builds only: also trust user-installed CAs (HTTP Toolkit, Charles). Release keeps system CAs only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
