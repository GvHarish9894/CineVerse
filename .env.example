# Copy to `.env` (git-ignored) and fill in. Used only for manual real-account acceptance
# (signing in to https://www.themoviedb.org during approval/import checks). Never commit `.env`.
#
# Build/runtime API access stays in `secrets.properties` (TMDB_READ_ACCESS_TOKEN) — see README.

# TMDB website login (the account used to approve the app's request token)
TMDB_USERNAME=
TMDB_PASSWORD=

# Optional: v3 API key / v4 read token, if a script needs them outside Gradle
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
