<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: settings and guest library may be backed up; the credential DataStore never is. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
