{
  "$description": "CineVerse design tokens, shared by TV, mobile and web. Values are taken from the clickable prototypes.",
  "color": {
    "background": "#07060F",
    "surface": "#0B0A16",
    "surfaceRaised": "#16132B",
    "surfaceSheet": "#16132B",
    "surfaceGlass": "rgba(20,18,38,0.82)",
    "tile": "rgba(255,255,255,0.06)",
    "tileFocused": "rgba(255,255,255,0.16)",
    "stroke": "rgba(255,255,255,0.08)",
    "textPrimary": "#F4F2FF",
    "textSecondary": "rgba(244,242,255,0.72)",
    "textTertiary": "rgba(244,242,255,0.58)",
    "onAccent": "#14030C",
    "onFocus": "#0B0A16",
    "focus": "#FFFFFF",
    "accent": "#FF3D7F",
    "accentAlternates": ["#22D3EE", "#A3E635", "#FFB020"],
    "secondary": "#7C3AED",
    "gold": "#FFC24B",
    "onGold": "#1A1205",
    "scoreHigh": "#21D07A",
    "scoreMid": "#D2D531",
    "scoreLow": "#DB2360",
    "scoreNone": "#6B7280",
    "danger": "#FF5C5C"
  },
  "scrim": {
    "left": "linear 90deg: #07060F 0% → 0.94 @27% → 0.62 @50% → 0 @78%",
    "bottom": "linear 0deg, height 72%: #07060F 0% → 0.92 @38% → 0 @100%",
    "top": "linear 180deg, height 130px (TV) / 100px (mobile): 0.75 → 0",
    "deepDim": "#07060F at 0.74 opacity, fades in over 500ms when detail content scrolls past the hero",
    "modal": "rgba(5,4,12,0.62–0.72) + backdrop blur 6–14px",
    "posterBottom": "linear 0deg: rgba(0,0,0,0.62) 0% → 0 58% (keeps poster titles legible)"
  },
  "glow": {
    "ambient": "two radial gradients of the focused/featured item's two palette colours, blurred 70–90px, saturate 150%, blend screen; opacity 0.42 × strength (TV), 0.60 × strength (mobile), 0.45 × strength (web); default strength 0.70",
    "focusedCard": "0 0 0 3px #FFFFFF, 0 18px 46px -10px {c1}, 0 0 70px -8px {c1}",
    "hoveredCard": "0 26px 60px -18px {c1}, 0 0 0 2px rgba(255,255,255,0.85)",
    "restingCard": "0 14px 30px -16px {c1}, 0 0 0 1px rgba(255,255,255,0.06)"
  },
  "typography": {
    "display": { "family": "Bricolage Grotesque", "weights": [500, 700, 800], "tracking": "-0.02em to -0.04em" },
    "body": { "family": "Inter", "weights": [400, 500, 600, 700] },
    "scaleTV": { "hero": 60, "heroLong": 46, "detailTitle": 56, "pageTitle": 44, "rowTitle": 20, "body": 16, "label": 13.5, "eyebrow": 13 },
    "scaleMobile": { "largeTitle": 34, "heroTitle": 32, "detailTitle": 27, "rowTitle": 20, "body": 15, "label": 13, "caption": 11.5 },
    "scaleWeb": { "hero": 76, "detailTitle": 52, "pageTitle": 48, "sectionTitle": 26, "body": 16.5, "card": 15 }
  },
  "radius": { "chip": 999, "button": 999, "card": 14, "cardLarge": 20, "tile": 14, "sheet": 30, "dialog": 28, "tabBar": 26, "phoneFrame": 44 },
  "spacing": { "tvSafeX": 48, "tvSafeY": 27, "tvContentLeft": 120, "mobileGutter": 20, "webMaxWidth": 1320, "webGutter": 32, "webGutterPhone": 16, "rowGap": 24, "cardGap": 12 },
  "size": {
    "tvPoster": [132, 198], "tvLandscape": [240, 135], "tvPerson": 124, "tvRail": [88, 268],
    "mobilePoster": [118, 177], "mobileLandscape": [250, 141], "mobilePerson": 92, "mobileTabBar": 70,
    "webPoster": [180, 270], "webVideo": [340, 191], "webPersonCard": [156, 195]
  },
  "motion": {
    "focusScale": 1.08, "focusScaleWide": 1.025, "pressScale": 0.95,
    "focusMove": "260ms cubic-bezier(.2,.8,.2,1)",
    "bump": "320ms cubic-bezier(.3,1.5,.5,1): 1 → 1.12 → 1.08",
    "edgeShake": "340ms: ±8px on the blocked axis",
    "rowScroll": "380ms cubic-bezier(.2,.8,.2,1)",
    "crossfade": "700ms cubic-bezier(.2,.8,.2,1), scale 1.035 → 1",
    "sheet": "400ms cubic-bezier(.2,.9,.25,1) slide up",
    "heroAutoAdvance": "8000ms (web), paused on hover"
  },
  "haptics": {
    "strengthMs": { "light": 6, "medium": 12, "strong": 20 },
    "tick": "[base]  focus move / swipe snap",
    "edge": "[base+8, 45, base+8]  blocked move",
    "confirm": "[base*2]  OK / select",
    "back": "[base, 30, base]",
    "success": "[base+4, 50, base*2]  saved, rated, signed in",
    "toggle": "[base, 30, base]"
  }
}
